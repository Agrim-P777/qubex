  "observability": {
    "dashboards": [
      {
        "name": "production-overview",
        "panels": [
          {
            "title": "Request Rate",
            "query": {
              "language": "promql",
              "expression": "sum(rate(http_requests_total[5m])) by (service)"
            },
            "thresholds": [
              {
                "op": ">",
                "value": 5000,
                "severity": "warning"
              }
            ]
          },
          {
            "title": "Error Budget",
            "query": {
              "language": "promql",
              "expression": "1 - (sum(rate(http_errors_total[1h])) / sum(rate(http_requests_total[1h])))"
            },
            "thresholds": [
              {
                "op": "<",
                "value": 0.999,
                "severity": "warning"
              },
              {
                "op": "<",
                "value": 0.995,
                "severity": "critical"
              }
            ]
          }
        ]
      }
